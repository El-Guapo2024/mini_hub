<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Mini Hub</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>mini_hub</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- The app has no cryptography of its own: answers are stored in a
	     local SQLite file and nothing is sent anywhere. Declaring it here
	     stops App Store Connect asking the same question on every upload,
	     and an unanswered question holds the build out of TestFlight. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Hold the mic to ask the reading companion a question by voice.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turns your spoken question into text for the reading companion.</string>
	<!-- The app never opens the camera or the photo library itself, but
	     file_picker bundles DKImagePickerController, which references the
	     Photos and Camera APIs. Apple requires a purpose string for an API
	     the binary merely references, so without these two the upload
	     succeeds, passes altool's validation, and is then discarded during
	     processing as ITMS-90683 — reported only by email. Builds 10 to 14
	     were lost exactly this way. Location is the same story and is only
	     a warning, but it is declared here so the warning stays quiet. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Lets you pick a page or cover image from your photos when adding a text to the library.</string>
	<key>NSCameraUsageDescription</key>
	<string>Lets you photograph a page when adding a text to the library.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>The reader does not use your location. A bundled file-picker component references the location API, which Apple requires be declared.</string>
</dict>
</plist>
